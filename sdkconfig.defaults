# Target chip (without this a fresh clone builds for the default esp32)
CONFIG_IDF_TARGET="esp32s3"

# 8 MB flash on the devkit
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_mender.csv"

# Demo polling intervals
CONFIG_MENDER_CLIENT_UPDATE_POLL_INTERVAL=30
CONFIG_MENDER_CLIENT_INVENTORY_REFRESH_INTERVAL=60
